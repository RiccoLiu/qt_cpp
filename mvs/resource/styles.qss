/* styles.qss */
QWidget {
    background-color: #2b2b2b;
    color: #e0e0e0;
    font-size: 10pt;
}

QTreeView, QTabWidget, QGroupBox {
    background-color: #3c3c3c;
    border: 1px solid #555;
}

QHeaderView::section {
    background-color: #444;
    color: white;
    padding: 4px;
    border: 1px solid #666;
}

QPushButton {
    background-color: #555;
    border: 1px solid #777;
    padding: 5px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #666;
}
